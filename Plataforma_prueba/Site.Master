<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.master.vb" Inherits="Plataforma_prueba.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Mesa de Ayuda TIC</title>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <link href="~/Styles/estilos.css" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <header>
            <img src="<%= ResolveUrl("~/Images/LOGOUCEENM.png") %>" alt="Logo UCENM" width="250" height="105" />
            <h1>Bienvenido a la Mesa de ayuda TIC</h1>
            <nav>
                <ul>
                    <li><a runat="server" href="~/Default.aspx">Inicio</a></li>
                    <li><a runat="server" href="~/Pages/ServicioTic.aspx">Servicios TIC</a></li>
                    <li><a runat="server" href="~/Pages/RegistrarTicket.aspx">Registrar Ticket</a></li>
                    <li><a runat="server" href="~/Pages/ConsultaTicket.aspx">Consultar Ticket</a></li>
                    <li><a runat="server" href="~/Pages/BaseConocimiento.aspx">Centro de Ayuda</a></li>
                    <li><a runat="server" href="~/Pages/Nosotros.aspx">Nosotros</a></li>
                    <li><a runat="server" href="~/Pages/Contacto.aspx">Contacto</a></li>
                </ul>
            </nav>
        </header>

        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <section>
                    <h2>Contacto</h2>
                    <ul>
                        <li>Correo: <a href="mailto:soporte@ucenm.net">soporte@ucenm.net</a></li>
                        <li>Teléfono: <a href="tel:+50400000000">+504 2700-1278</a></li>
                        <li>Extensión para soporte: 101</li>
                        <li>Horario: Lunes a viernes, 8:00 am - 5:00 pm</li>
                        <li>Sábado de 8:00 am - 12:00 pm</li>
                        <li>Dirección: UCENM, Campus Catacamas Olancho</li>
                    </ul>
                </section>
                <p>&copy; <%: DateTime.Now.Year %> UCENM Catacamas - Olancho</p>
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <script>
        (function () {
            var current = window.location.pathname.toLowerCase().replace(/\/$/, '');
            if (current === '') { current = '/default.aspx'; }
            var links = document.querySelectorAll('nav a[href]');
            links.forEach(function (link) {
                var linkPath = new URL(link.href, window.location.origin).pathname.toLowerCase().replace(/\/$/, '');
                if (linkPath === '') { linkPath = '/default.aspx'; }
                var currentName = current.split('/').pop();
                var linkName = linkPath.split('/').pop();
                if (current === linkPath || currentName === linkName) {
                    link.classList.add('active');
                }
            });
        })();
    </script>
</body>
</html>
